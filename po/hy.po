#: src/Application.vala:129
msgid ""
"Tasks will automatically start when this device turns on and run when its "
"window is closed so that it can send notifications for due tasks."
msgstr ""
"Tasks-ը ավտոմատ կմեկնարկի սարքը միացնելիս և կշարունակի աշխատել նույնիսկ "
"պատուհանը փակելուց հետո՝ ժամկետը հասած առաջադրանքների մասին ծանուցումներ "
"ուղարկելու համար։"

#: src/MainWindow.vala:30
msgid "Tasks"
msgstr "Tasks"

#: src/MainWindow.vala:69
